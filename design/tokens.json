{
  "name": "Ynot design tokens",
  "version": 1,
  "notes": "Single source of visual identity for every platform shell. Shells map these to native units (pt on Apple, dp on Android, DIP on Windows).",
  "color": {
    "brand": { "primary": "#7C5CFF", "secondary": "#2BD9A8", "accent": "#FFB547" },
    "dark": {
      "background": "#0F1014", "surface": "#181A20", "surfaceRaised": "#22252D",
      "border": "#2E323C", "text": "#F2F3F5", "textMuted": "#9AA0AB",
      "record": "#FF4D5E", "meterLow": "#2BD9A8", "meterMid": "#FFB547", "meterHigh": "#FF4D5E"
    },
    "light": {
      "background": "#F7F7FA", "surface": "#FFFFFF", "surfaceRaised": "#FFFFFF",
      "border": "#DCDEE5", "text": "#14161B", "textMuted": "#5D6370",
      "record": "#E0283A", "meterLow": "#12A37D", "meterMid": "#D98A00", "meterHigh": "#E0283A"
    },
    "trackPalette": ["#7C5CFF", "#2BD9A8", "#FFB547", "#FF6B9A", "#4DA3FF", "#B8E04A", "#FF8A4D", "#A98BFF"]
  },
  "typography": {
    "family": { "ui": "Inter", "mono": "JetBrains Mono" },
    "nativeFallback": { "macos": "SF Pro", "ios": "SF Pro", "windows": "Segoe UI Variable", "android": "Roboto" },
    "size": { "caption": 11, "body": 13, "bodyTouch": 15, "title": 17, "header": 22 }
  },
  "spacing": { "xxs": 2, "xs": 4, "sm": 8, "md": 12, "lg": 16, "xl": 24, "xxl": 32 },
  "radius": { "control": 6, "card": 10, "sheet": 16 },
  "touchTarget": { "apple": 44, "android": 48, "precisePointer": 24 },
  "motion": { "fast": 120, "standard": 200, "slow": 320, "easing": "cubic-bezier(0.2, 0, 0, 1)" },
  "layoutBreakpoints": { "compactMax": 600, "mediumMax": 840, "expandedMax": 1280 }
}
